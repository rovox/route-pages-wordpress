# Copy this file to .env.dev and adjust values if needed, then run:
#   docker compose --env-file .env.dev -f docker-compose.dev.yml up -d
#
# Defaults in docker-compose.dev.yml already work without a .env.dev file;
# this is only needed to change ports/credentials.

MYSQL_ROOT_PASSWORD=changeme_root
WP_DBNAME=wordpress
WP_DBUSER=wordpress
WP_DBPASSWORD=changeme

WP_PORT=8081
PMA_PORT=8080

WORDPRESS_DEBUG=1
